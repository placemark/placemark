# Geocode Earth token for geocoding/search
# from https://app.geocode.earth/
VITE_PUBLIC_GEOCODE_EARTH_TOKEN=xxx

# Optional routing provider: openrouteservice, geoapify, or osrm
VITE_PUBLIC_ROUTING_PROVIDER=
# Required for hosted openrouteservice and Geoapify
VITE_PUBLIC_ROUTING_API_KEY=
# Optional custom openrouteservice or Geoapify endpoint
VITE_PUBLIC_ROUTING_URL=
# OSRM endpoints are configured separately for each available profile
VITE_PUBLIC_OSRM_DRIVING_URL=
VITE_PUBLIC_OSRM_WALKING_URL=
VITE_PUBLIC_OSRM_CYCLING_URL=
